rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helpers
    function isValidCompany(data) {
      return data.keys().hasAll(['id', 'name', 'code', 'adminName', 'createdAt']) &&
             data.id is string && data.name is string && data.code is string &&
             data.adminName is string && data.createdAt is string;
    }

    function isValidUserAccount(data) {
      return data.keys().hasAll(['id', 'companyCode', 'name', 'username', 'password', 'role', 'mustChangePassword', 'active']) &&
             data.id is string && data.companyCode is string && data.name is string &&
             data.username is string && data.password is string && data.role in ['admin', 'dirigente', 'operativo'];
    }

    // Companies collection
    match /companies/{companyId} {
      allow read: if true;
      allow create: if isValidCompany(incoming());
      allow update: if isValidCompany(incoming());
      allow delete: if true;

      // Subcollections within company
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /pairingCodes/{code} {
      allow read, write: if true;
    }

    match /transferCodes/{code} {
      allow read, write: if true;
    }

    // Global default catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
